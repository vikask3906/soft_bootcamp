  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "onnxruntime-web": "^1.30.0"
  },
  "private": true,
  "type": "module"
